generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String @unique
  items Item[]

  @@map("categories")
}

model Item {
  id         Int        @id @default(autoincrement())
  categoryId Int
  name       String
  slug       String     @unique
  unit       String
  category   Category   @relation(fields: [categoryId], references: [id])
  prices     Price[]

  @@map("items")
}

model Location {
  id      Int     @id @default(autoincrement())
  name    String
  slug    String  @unique
  country String  @default("Peru")
  prices  Price[]

  @@map("locations")
}

model Source {
  id     Int     @id @default(autoincrement())
  name   String
  url    String?
  prices Price[]

  @@map("sources")
}

model Price {
  id          Int      @id @default(autoincrement())
  itemId      Int
  locationId  Int
  sourceId    Int?
  priceMin    Decimal  @db.Decimal(10,2)
  priceMax    Decimal  @db.Decimal(10,2)
  priceAvg    Decimal  @db.Decimal(10,2)
  currency    String   @default("PEN")
  lastUpdated DateTime
  summary     String
  notes       String?
  isPublished Boolean  @default(true)

  item        Item     @relation(fields: [itemId], references: [id])
  location    Location @relation(fields: [locationId], references: [id])
  source      Source?  @relation(fields: [sourceId], references: [id])

  @@unique([itemId, locationId])
  @@map("prices")
}
model MarketAsset {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  symbol      String?
  type        String
  price       Decimal  @db.Decimal(12, 4)
  currency    String   @default("PEN")
  summary     String?
  source      String?
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}